    issues_framed: List[IssueFramedItem]
    material_facts: List[str]
    procedural_journey: str = Field(..., description="Summary of trial court -> appellate journey")
    ratio_decidendi: RatioDecidendiItem
    obiter_dicta: List[ObiterDictaItem]
    statutes_interpreted: List[StatuteInterpretedItem]
    one_line_takeaway: str

# ── 3. Citation Formatter Models ──
class FormatCitationRequest(BaseModel):

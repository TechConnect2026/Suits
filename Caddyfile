{$API_DOMAIN:http://:80} {
    encode gzip zstd

    # Route all API traffic to FastAPI backend
    @api path /api /api/*
    handle @api {
        reverse_proxy backend:8000 {
            flush_interval -1
            header_up X-Real-IP {remote_host}
        }
    }

    # Ensure .mjs and .js modules have strict JavaScript MIME type
    @mjs path *.mjs
    header @mjs Content-Type "application/javascript; charset=utf-8"

    # Route all web app traffic, SPA routing, and static assets to Frontend Nginx
    handle {
        reverse_proxy frontend:80
    }
}

